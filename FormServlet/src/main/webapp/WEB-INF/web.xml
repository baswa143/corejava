
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">
    <display-name>FormServlet</display-name>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>MsgServlet</servlet-name>
        <servlet-class>com.example.MsgServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MsgServlet</servlet-name>
        <url-pattern>/msg</url-pattern>
    </servlet-mapping>

</web-app>