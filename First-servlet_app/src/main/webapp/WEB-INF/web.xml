
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">
    <display-name>First-servlet_app</display-name>
    <welcome-file-list>
        <welcome-file>index1.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>GreetServlet</servlet-name>
        <servlet-class>com.example.GreetServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GreetServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

</web-app>